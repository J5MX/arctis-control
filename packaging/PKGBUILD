# Maintainer: J5MX <35576890+J5MX@users.noreply.github.com>
#
# Compila desde la copia local del repositorio (la carpeta superior a esta).
# Uso:  cd packaging && makepkg -si

pkgname=arctis-control
pkgver=0.3.0
pkgrel=1
pkgdesc="Panel no oficial para auriculares SteelSeries Arctis: batería, ecualizador y ajustes (HeadsetControl)"
arch=('x86_64')
url="https://github.com/J5MX/arctis-control"
license=('GPL-3.0-or-later')
depends=('headsetcontrol' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'gcc-libs' 'glibc')
makedepends=('cmake')
optdepends=('ttf-fira-sans: tipografía de la interfaz')
provides=('nova5-panel')
conflicts=('nova5-panel')
replaces=('nova5-panel')

build() {
  cmake -B build -S "$startdir/.." \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
